<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <!-- Windows 走 windows10 TFM 以获得 CsWinRT 投影（系统媒体控制 SMTC 需要）。
         纯 net8.0 无 WinRT 投影，SMTC 只能靠手搓 vtable 调用，可读性差很多。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>TouhouMixCommunityEdition</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <SupportedOSPlatformVersion Condition=" '$(GodotTargetPlatform)' != 'android' ">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="OpenccNetLib" Version="1.6.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows SMTC 桥接依赖 CsWinRT（仅 windows10 TFM 具备），Android 侧用
         Java MediaSessionControl 插件实现，故不编译此文件。它不是 autoload，
         由 Game/SystemMediaSession.gd 在 Windows 下按需实例化。 -->
    <Compile Remove="CSharp/MediaSessionControlCs.cs" Condition=" '$(GodotTargetPlatform)' == 'android' " />
  </ItemGroup>
</Project>