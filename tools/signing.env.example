# Android 发布签名配置模板。
# 复制成 tools/signing.env 后填入真实值——该文件已被 .gitignore 忽略，不会进仓库。
# release.py 只读取「尚未在环境变量里存在」的键，所以临时 export 的优先级更高。

# release keystore 路径（不是 debug.keystore）
THMIX_ANDROID_KEYSTORE=C:/path/to/thmix-release.jks
# 签名别名
THMIX_ANDROID_KEYSTORE_USER=thmix-ce
# 签名密码
THMIX_ANDROID_KEYSTORE_PASSWORD=change-me
